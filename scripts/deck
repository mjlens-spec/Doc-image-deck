#!/bin/sh
# Doc-image-deck（文图方案）launcher for macOS. usage: deck <command> [args]   (deck help)
# Runs deck.py with the runtime's Python when it exists, otherwise with python3 (enough for check / setup).
S=$(cd "$(dirname "$0")" && pwd)
R=${DOC_IMAGE_DECK_HOME:-$HOME/.local/share/doc-image-deck}
export PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1
if [ -x "$R/venv/bin/python" ]; then exec "$R/venv/bin/python" -X utf8 "$S/deck.py" "$@"; fi
exec python3 -X utf8 "$S/deck.py" "$@"
